PORT=3030
NODE_ENV=development

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Graph API)
# -----------------------------------------------------------------------------
# Dónde obtenerlos: Meta Developer Console → Tu app → WhatsApp → API Setup
#
# META_VERIFY_TOKEN
#   Cadena que TÚ inventas; la misma debes pegar en el campo "Verify token" del
#   webhook en Meta (Configuration → Webhook). GET /webhook la valida.
#
# META_ACCESS_TOKEN
#   Token de la app (temporal de prueba o de larga duración según tu flujo).
#   Debe incluir permisos para whatsapp_business_messaging, etc.
#
# META_PHONE_NUMBER_ID
#   ID del número de teléfono de WhatsApp (no es el número en sí; es el ID numérico
#   que muestra la consola junto al número de prueba o de producción).
#
# META_GRAPH_API_VERSION (opcional)
#   Por defecto v21.0. Cambia si Meta te indica otra versión en la documentación.
#
# Enviar mensajes (saliente)
#   Este servicio usa POST .../PHONE_NUMBER_ID/messages con tu META_ACCESS_TOKEN.
#   En sandbox solo puedes escribir a números que hayas agregado como "destinatarios de prueba".
#
# "Leer chats" (entrante)
#   La Cloud API NO expone historial de conversación. Solo recibes mensajes NUEVOS
#   cuando Meta hace POST a tu URL de webhook (tú debes exponer HTTPS público).
#   En local usa ngrok, Cloudflare Tunnel, etc.: https://TU_TUNEL/webhook
#
# Pasos en Meta Developer Portal
#   1. WhatsApp → Configuration → Webhook → Edit
#   2. Callback URL: https://tu-dominio.com/webhook  (mismo path que este servidor)
#   3. Verify token: igual que META_VERIFY_TOKEN
#   4. Suscríbete al campo "messages" (y "message_status" si luego quieres acuses)
#   5. Guarda; Meta hará GET /webhook?hub.mode=subscribe&hub.verify_token=...&hub.challenge=...
#
META_VERIFY_TOKEN=your_verify_token
META_ACCESS_TOKEN=your_long_lived_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
# META_GRAPH_API_VERSION=v21.0

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=your_gcp_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
# Use quotes; newlines in the key can be escaped as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: protect POST /internal/searches/:searchId/distribute (header x-hommi-internal-secret)
# INTERNAL_DISTRIBUTE_SECRET=your_long_random_secret
